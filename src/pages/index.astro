---
import Arrow from '../components/Arrow.astro';
import type { CollectionEntry } from 'astro:content';
import EditorialLayout from '../layouts/EditorialLayout.astro';
import DispatchCard from '../components/DispatchCard.astro';
import WorkCard from '../components/WorkCard.astro';
import EmptyState from '../components/EmptyState.astro';
import OpeningNote from '../components/OpeningNote.astro';
import { editorialContent } from '../lib/content';
import { eventLabel, featuredEntry, formatDate, plainExcerpt, selectEvent } from '../lib/content-policy';
import { author, bookStatuses } from '../lib/site';
import { chapterOrder } from '../lib/reading';
import { hasAuthorPortrait, portraitPath } from '../lib/portrait';
const hasPortrait = hasAuthorPortrait();
const { dispatches, works, book, events, includesDrafts } = await editorialContent();
const featured = featuredEntry(dispatches);
const recent = dispatches.slice(0, 3);
type JournalItem = { kind: 'dispatch'; entry: CollectionEntry<'dispatches'> } | { kind: 'work'; entry: CollectionEntry<'works'> };
const curated: JournalItem[] = [
  ...works.map((entry): JournalItem => ({ kind: 'work', entry })),
  ...dispatches.filter((entry) => entry.data.featured).map((entry): JournalItem => ({ kind: 'dispatch', entry })),
];
// Include a field note in the mixed selection even before an editor features one.
if (featured && !curated.some(({ entry }) => entry.collection === 'dispatches')) curated.push({ kind: 'dispatch', entry: featured });
curated.sort((a, b) => Number(b.entry.data.featured) - Number(a.entry.data.featured) || b.entry.data.date.getTime() - a.entry.data.date.getTime() || a.entry.id.localeCompare(b.entry.id));
const overview = book.find(({ data }) => data.kind === 'overview');
const excerpts = chapterOrder(book.filter(({ data }) => data.kind === 'excerpt'));
const now = new Date();
const event = selectEvent(events, now);
const stats = [
  { label: 'Field dispatches', count: dispatches.length, href: '/dispatches/' },
  { label: 'Original works', count: works.length, href: '/works/' },
  { label: 'Book excerpts', count: excerpts.length, href: '/book/#excerpts' },
];
---
<EditorialLayout draftPreview={includesDrafts}>
  <div class="page-width">
    <section class="manifesto" aria-labelledby="manifesto-title">
      <div class="manifesto-main">
        <p class="eyebrow manifesto-label"><span class="section-number">01 /</span> A writer’s notebook, open to the world</p>
        <h1 id="manifesto-title">Every life is<br />a story worth<br /><em>staying for.</em></h1>
        <p class="manifesto-deck">On human connection, the lives we carry within,<br class="desktop-break" /> and the extraordinary act of paying attention.</p>
        <a class="editorial-button" href="/dispatches/">Enter the journal <span aria-hidden="true"><Arrow direction="down-right" /></span></a>
      </div>
      <aside class="author-note" aria-label="About the author">
        {hasPortrait ? (
          <figure class="author-portrait-frame">
            <img src={portraitPath} alt="Portrait of Yushay Aizaz" width="1080" height="1440" loading="lazy" decoding="async" />
          </figure>
        ) : <span class="author-flourish" aria-hidden="true">ya.</span>}
        <p class="eyebrow">Yushay Aizaz<br /><span class="text-muted">Writer · Budapest</span></p>
        <p>I’m drawn to the stories people tell when the day slows down. The small revelations. The things we almost leave unsaid.</p>
        <p>My work moves between computer science, psychology, and the human lives that refuse to fit neatly into either.</p>
        <a class="quiet-link" href="/book/">A book is taking shape <span aria-hidden="true"><Arrow direction="up-right" /></span></a>
      </aside>
    </section>

    <section class="archive-strip" aria-label={includesDrafts ? 'Working archive statistics, including drafts' : 'Published archive statistics'}>
      <p class="archive-label"><span class="eyebrow">{includesDrafts ? 'The working archive' : 'The living archive'}</span><span>{includesDrafts ? 'Includes unpublished drafts' : 'One page at a time.'}</span></p>
      <dl class="archive-stats">{stats.map((stat) => <div><dt><a href={stat.href}>{stat.label}</a></dt><dd>{String(stat.count).padStart(2, '0')}</dd></div>)}</dl>
    </section>

    <section class="editorial-section" id="dispatches" aria-labelledby="dispatches-title">
      <div class="section-heading"><div><p class="eyebrow"><span class="section-number">02 /</span> From the field</p><h2 id="dispatches-title">The Evening Dispatches</h2></div><p>Encounters, observations,<br />and the stories between them.</p></div>
      {featured ? <><div class="featured-label"><span class="tiny-rule" aria-hidden="true"></span><p class="eyebrow">{featured.data.featured ? 'An editor’s selection' : 'The latest field note'}</p></div><DispatchCard entry={featured} featured /></> : <EmptyState eyebrow="The first dispatch" title="A quiet page. An open invitation." text="The next conversation is still unfolding. Field notes will find their home here when they are ready to be shared." />}
      <div class="subsection-heading" id="recent-dispatches"><h3>Recent dispatches</h3><p class="eyebrow">Notes from an ongoing life</p></div>
      {recent.length > 0 ? <div class="dispatch-grid" data-recent-dispatches>{recent.map((entry) => <DispatchCard entry={entry} />)}</div> : <p class="empty-inline">No dispatches have been published yet. For now, follow the evening notes <a href={author.instagram}>on Instagram <Arrow direction="up-right" /></a>.</p>}
    </section>

    <section class="editorial-section" id="works" aria-labelledby="works-title">
      <div class="section-heading"><div><p class="eyebrow"><span class="section-number">03 /</span> Selected pages</p><h2 id="works-title">From the writing desk</h2></div><p>Original essays and poems,<br />in conversation with the field notes.</p></div>
      {curated.length > 0 ? <div class="journal-grid" data-curated-journal>{curated.slice(0, 6).map((item) => item.kind === 'work' ? <WorkCard entry={item.entry} /> : <DispatchCard entry={item.entry} />)}</div> : <EmptyState eyebrow="Original works" title="Some words ask for a little longer." text="Essays, poetry, short stories and reflections will gather here. There is room for a different pace on the page." compact />}
      {curated.length > 0 && works.length === 0 && <p class="empty-inline">Original works are still at the writing desk. The field notes above are the first pages of the journal.</p>}
    </section>

    <section class="book-section" id="book" aria-labelledby="book-title">
      <div class="book-margin"><span class="eyebrow">04 / The long work</span><div class="book-mark" aria-hidden="true"><span>Y A</span><span class="book-mark-rule"></span><span>Notes toward<br />a book</span></div><p>A work in progress.<br />A practice of listening.</p></div>
      <div class="book-copy">
        <div class="card-overline"><p class="eyebrow">{overview ? bookStatuses[overview.data.status] : 'At the writing desk'}</p>{overview?.data.draft && <span class="draft-badge">Draft</span>}</div>
        <h2 id="book-title">{overview?.data.title ?? 'The book in progress'}</h2>
        {overview?.data.subtitle && <p class="book-subtitle">{overview.data.subtitle}</p>}
        <p class="book-premise">{overview?.data.synopsis ?? 'A book about the beautiful, powerful reality of human connection and inner life. The public synopsis and first excerpts will appear here when they are ready.'}</p>
        {overview && <div class="book-progress"><div><label for="manuscript-progress">Manuscript progress</label><span>{overview.data.progress}%</span></div><progress id="manuscript-progress" value={overview.data.progress} max="100">{overview.data.progress}%</progress></div>}
        {overview && overview.data.thematicPillars.length > 0 && <ul class="book-pillars" aria-label="Thematic pillars">{overview.data.thematicPillars.map((pillar) => <li>{pillar}</li>)}</ul>}
        {excerpts.length > 0 ? <div class="book-excerpts"><p class="eyebrow">An opening into the manuscript</p>{excerpts.slice(0, 2).map((entry) => <article><div class="card-overline"><h3>{entry.data.title}</h3>{entry.data.draft && <span class="draft-badge">Draft</span>}</div><OpeningNote text={plainExcerpt(entry.body, 850)} /></article>)}</div> : <p class="book-footnote">The first excerpt is still with the author.</p>}
        <a class="book-showroom-link" href="/book/">Explore the book project <Arrow /></a>
      </div>
    </section>

    <section class="ledger-section" id="ledger" aria-labelledby="ledger-title">
      <div><p class="eyebrow"><span class="section-number">05 /</span> Beyond the page</p><h2 id="ledger-title">The literary ledger</h2>
        <nav class="ledger-links" aria-label="More from the ledger">
          <a class="text-link" href="/achievements/">Explore the full ledger <Arrow /></a>
          <a class="text-link" href="/achievements/#press-kit">Writer press &amp; speaker kit <Arrow /></a>
        </nav>
      </div>
      {event ? <article class="ledger-entry"><div class="card-overline"><p class="eyebrow">{eventLabel(event.data.type, event.data.date, now)}</p>{event.data.draft && <span class="draft-badge">Draft</span>}</div><h3>{event.data.title}</h3><p>{event.data.description}</p><div class="card-meta"><time datetime={event.data.date.toISOString()}>{formatDate(event.data.date)}</time>{event.data.location && <><span aria-hidden="true">·</span><span>{event.data.location}</span></>}{event.data.organization && <><span aria-hidden="true">·</span><span>{event.data.organization}</span></>}</div>{event.data.externalUrl && <a class="text-link" href={event.data.externalUrl}>Event or publication details <Arrow direction="up-right" /></a>}</article> : <div class="ledger-empty"><p class="eyebrow">Room for what comes next</p><p>Readings, publications and writing milestones will be recorded here. No announcements just yet.</p><a class="text-link" href="#contact">Start a conversation <Arrow direction="up-right" /></a></div>}
    </section>
  </div>
</EditorialLayout>
