---
import Arrow from './Arrow.astro';
import { author, navigation } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer" id="contact">
  <div class="page-width">
    <div class="footer-top">
      <div>
        <p class="eyebrow">Keep the conversation going</p>
        <p class="footer-invitation">There is always<br />another story.</p>
      </div>
      <div class="footer-contact">
        <p>For a conversation, a reading,<br />or a note about the writing.</p>
        <a class="text-link" href={author.instagram}>Write to {author.handle} <span aria-hidden="true"><Arrow direction="up-right" /></span></a>
        <div class="social-links"><a href={author.instagram}>Instagram <Arrow direction="up-right" /></a><a href={author.threads}>Threads <Arrow direction="up-right" /></a></div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {year} {author.name}. Written with attention.</p>
      <nav aria-label="Footer navigation">{navigation.map((link) => <a href={link.href}>{link.label}</a>)}</nav>
      <a href="#top">Back to the beginning <Arrow direction="up" /></a>
    </div>
  </div>
</footer>
