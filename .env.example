# Optional while developing. Set the real HTTPS origin before deployment.
SITE_URL=
# Optional Behold JSON feed override. Leave empty for the bundled author feed.
BEHOLD_FEED_URL=
# Optional Instagram Login API for local use; never prefix secrets with PUBLIC_.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v27.0
# false publishes imported Instagram posts; true holds new imports for review.
INSTAGRAM_IMPORT_DRAFT=false
# Optional local sample preview. Effective only during astro dev; ignored by builds.
# Copy this file to .env, then restart npm run dev after changing this value.
INCLUDE_DRAFTS=true
