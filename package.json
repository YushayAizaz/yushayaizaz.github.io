{
  "name": "yushay-aizaz-author-platform",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <25"
  },
  "scripts": {
    "dev": "astro dev --ignore-lock",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "python3 -m unittest discover -s tests -v",
    "new:post": "python3 scripts/new_post.py",
    "sync:instagram": "python3 scripts/sync_instagram.py",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "test:integration": "node scripts/test_site.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.19.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  }
}
